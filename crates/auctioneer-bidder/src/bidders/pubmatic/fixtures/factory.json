          {
            "id": "i",
            "banner": {
              "w": 300,
              "h": 250
            },
            "ext": {
              "bidder": {
                "publisherId": "fake_publisher",
                "adSlot": "fake_slot@300x250"
              }
            }
          }
        ],
        "ext": {
          "fake_unrelated": {
            "preserve": false
          }
        }
      },
      "context": {
        "account_id": "catalog-account",
