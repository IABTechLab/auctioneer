{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Synthetic sample selection compiler control",
  "description": "Independent fake-bidder control for nested exclusive selectors and annotation alternatives.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sample_index": { "type": ["integer", "string"] },
    "sample_name": { "type": "string", "minLength": 1 },
    "window": {
      "type": "object",
      "properties": {
        "start": { "type": "integer" },
        "end": { "type": "integer" }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "annotations": {
      "anyOf": [
        { "type": "array", "items": { "$ref": "#/definitions/annotation" } },
        { "$ref": "#/definitions/annotation" }
      ]
    }
  },
  "oneOf": [
    {
      "oneOf": [
        { "required": ["sample_index"] },
        { "required": ["sample_name"] }
      ]
    },
    { "required": ["window"] }
  ],
  "definitions": {
    "annotation": {
      "type": "object",
      "properties": { "label": { "type": "string" } },
      "required": ["label"],
      "additionalProperties": false
    }
  }
}
