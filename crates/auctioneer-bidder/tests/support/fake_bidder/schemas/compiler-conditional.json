{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic paired markers compiler control",
  "description": "Independent fake-bidder begin and finish markers must occur together only when the chosen draft supports conditionals.",
  "type": "object",
  "properties": {
    "begin": { "type": "string", "minLength": 1 },
    "finish": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    { "if": { "required": ["begin"] }, "then": { "required": ["finish"] } },
    { "if": { "required": ["finish"] }, "then": { "required": ["begin"] } }
  ],
  "additionalProperties": false
}
