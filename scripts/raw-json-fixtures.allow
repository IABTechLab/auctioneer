# A probe whose claim is that PARSING this source key order yields
# sorted keys, which is what proves the map is BTreeMap-backed.
# `json!` would construct the map directly and observe nothing.
crates/auctioneer-exchange/tests/node_charge.rs 1

# Compact exponent spellings are the ingress byte measurement. Constructing
# these numeric tokens with json! would canonicalize away the growth witness.
crates/auctioneer-core/tests/normalized_numeric_source.rs 1

# Snapshots compared with `assert_eq!` against `to_string`: the exact
# serialized bytes are the contract this file exists to pin.
crates/auctioneer-config/tests/baked_defaults_snapshot.rs 2

