+/// Shallow value and payload layouts reported by [`Regex::resource_layout`].
+///
+/// These layouts exclude Arc headers, referenced allocations, allocator
+/// overhead and recursive heap usage. Equal layouts do not establish sharing.
+/// The report retains no regex data and does not identify its strategy.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct RegexResourceLayout {
+    value: Layout,
+    regex_payload: Layout,
+    metadata_payload: Layout,
+    strategy_payload: Layout,
+}
+
+impl RegexResourceLayout {
+    /// Returns the layout of the complete public [`Regex`] value.
+    pub fn value(&self) -> Layout {
+        self.value
+    }
+
+    /// Returns the layout of the private payload behind the regex Arc.
+    ///
+    /// This includes its inline handles, but not their referenced allocations.
+    pub fn regex_payload(&self) -> Layout {
+        self.regex_payload
+    }
+
+    /// Returns the layout of the private payload behind the metadata Arc.
+    ///
+    /// This excludes property buffers and configured-prefilter children.
+    pub fn metadata_payload(&self) -> Layout {
+        self.metadata_payload
+    }
+
+    /// Returns the layout of the concrete selected strategy payload.
+    ///
+    /// This includes embedded wrappers, handles and padding, but not children.
+    pub fn strategy_payload(&self) -> Layout {
+        self.strategy_payload
+    }
 }
 
